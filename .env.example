# Copy to .env and fill in real values locally. Never commit .env.
# No real secrets exist in this file.

# --- Core ---
DATABASE_URL="postgresql://user:password@localhost:5432/syracuse_labor_dev"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Feature flags (config/features.ts reads these) ---
FEATURE_SMS_PROVIDER="mock"
FEATURE_EMAIL_PROVIDER="mock"
FEATURE_PAYMENT_PROVIDER="mock"
FEATURE_GEO_PROVIDER="mock"
FEATURE_AI_PROVIDER="mock"

# --- Twilio (SMS) - leave blank until ready to connect ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Email provider - leave blank until ready to connect ---
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="no-reply@example.com"

# --- Stripe (payments) - leave blank; no real payments in Phase 1 ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Google Maps (address validation / distance) - leave blank until ready ---
GOOGLE_MAPS_API_KEY=""

# --- AI provider (resume parsing / matching assist) - leave blank until ready ---
AI_PROVIDER_API_KEY=""

# --- Background check provider - leave blank until ready ---
BACKGROUND_CHECK_API_KEY=""

# --- File storage for private worker/job documents ---
DOCUMENT_STORAGE_PROVIDER="local"
DOCUMENT_STORAGE_BUCKET=""
